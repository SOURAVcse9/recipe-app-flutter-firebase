rules_version = '2';

// SECURITY ASSUMPTIONS:
// - Recipes and categories are public read-only content.
// - Recipe/category modifications are restricted to admin users only (custom claim admin: true).
// - Users can read and write ONLY their own favorite recipe IDs under users/{uid}/favorites/{recipeId}.
// - Users can read and write ONLY their own settings under users/{uid}/preferences/{docId}.
// - Cross-user access is rejected.

function isAdmin() {
  return request.auth != null && request.auth.token.admin == true;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared recipe collection
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shared category collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User-specific favorites subcollection
    match /users/{uid}/favorites/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User-specific preferences subcollection
    match /users/{uid}/preferences/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
