rules_version = '2';

// SECURITY ARCHITECTURE:
// - Recipes & Categories: Public read for recipes & categories; Admins (custom claim admin == true) have full read/write.
// - Authenticated users can modify ONLY the aggregate rating/review count/viewCount fields on recipes.
// - Users can read and write ONLY their own profile, favorites, settings, shopping list, reviews index, and viewed history under users/{uid}.
// - Reviews can be read by anyone, but created/updated/deleted only by their respective owner or admin.

function isAdmin() {
  return request.auth != null && request.auth.token.admin == true;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared recipe collection
    match /recipes/{recipeId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'review', 'viewCount'])
      );

      // Recipe reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Shared category collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profile document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User-specific notification_tokens subcollection
    match /users/{uid}/notification_tokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User-specific favorites subcollection
    match /users/{uid}/favorites/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User-specific preferences subcollection
    match /users/{uid}/preferences/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User-specific shoppingList subcollection
    match /users/{uid}/shoppingList/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User-specific recentlyViewed subcollection
    match /users/{uid}/recentlyViewed/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // User-specific reviews index subcollection
    match /users/{uid}/reviews/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
