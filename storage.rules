rules_version = '2';

// STORAGE SECURITY RULES:
// - Audience: Public read access to recipe, category, and ingredient images under image/**.
// - Admin: Only authenticated admins (custom claim admin == true) can upload or delete images.
// - Constraints: Allowed file size is capped at 5 MB; MIME type must match image/*.

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /image/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
