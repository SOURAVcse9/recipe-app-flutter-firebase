rules_version = '2';

// Public read (recipe/ingredient images need to load for every user),
// but writes are restricted to authenticated admins uploading through
// the admin/seed tooling — not to arbitrary app users.
// This replaces the original open development rule:
//   allow read, write: if request.time < timestamp.date(2024, 12, 31);
// which granted unrestricted access to anyone until a fixed date.

service firebase.storage {
  match /b/{bucket}/o {
    match /image/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.admin == true
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
