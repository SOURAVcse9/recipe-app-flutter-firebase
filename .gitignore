# ==============================================================================
# Production .gitignore for Flutter + Firebase Recipe App
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System & Local Temporary Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*.swp
*.swo
*~
*.class
*.log
*.pyc
*.bak
*.tmp

# ------------------------------------------------------------------------------
# 2. Local Media, Raw Screenshots, PDFs & Local Assets
# ------------------------------------------------------------------------------
images/
docs/images/
*.pdf
docs/*.pdf

# ------------------------------------------------------------------------------
# 3. IDE & Editor Specific Configs
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.cproject
.settings/

# ------------------------------------------------------------------------------
# 4. Flutter & Dart Build Outputs & Caches
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
/build/
doc/api/
coverage/
.widget_preview/

# ------------------------------------------------------------------------------
# 5. Android Build Files & Local Properties
# ------------------------------------------------------------------------------
android/.gradle/
android/build/
android/captures/
android/gradleBuild/
android/local.properties
android/app/build/
android/app/debug/
android/app/profile/
android/app/release/
android/key.properties
android/.idea/

# ------------------------------------------------------------------------------
# 6. iOS & macOS Build Files
# ------------------------------------------------------------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/ephemeral/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/App.framework
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/DerivedData/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3

# ------------------------------------------------------------------------------
# 7. Desktop & Web Build Ephemerals
# ------------------------------------------------------------------------------
windows/flutter/ephemeral/
windows/.gradle/
linux/flutter/ephemeral/
macos/Flutter/ephemeral/
*.dll
*.obj
*.so
*.dylib

# ------------------------------------------------------------------------------
# 8. CRITICAL: Security, Private Keys & Credentials (NEVER PUBLISH)
# ------------------------------------------------------------------------------
*.jks
*.keystore
*.pem
*.p12
*.pfx
key.properties
.env
.env.*
*.secret
secrets/
credentials/
private_keys/
**/serviceAccountKey.json
**/serviceAccountKey.json.local
**/firebase-adminsdk-*.json
sample_data/serviceAccountKey.json
*.serviceAccount.json

# ------------------------------------------------------------------------------
# 9. Node.js & Tooling (Seed script)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ------------------------------------------------------------------------------
# 10. AI Assistant & Local Workspace Caches
# ------------------------------------------------------------------------------
.gemini/
.system_generated/
scratch/
